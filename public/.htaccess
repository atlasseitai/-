# ======================================================================
# さくらインターネット & WordPress 連携用 Apache設定 (.htaccess)
# アトラスリラクゼーションサービス合同会社
# ======================================================================

# 文字コード設定 (UTF-8)
AddDefaultCharset UTF-8

# ブラウザキャッシュ設定 (表示速度向上 & サーバ負荷軽減)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# GZIP圧縮 (通信量圧縮・高速表示)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# SPA ルーティング & WordPress リライトルール重複防止
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 実在するファイルやディレクトリへのアクセスはそのまま処理
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # それ以外の内部パスは index.html へフォールバック
  RewriteRule ^ index.html [L]
</IfModule>

# WordPressや他サイトからの iframe 埋め込みを許可するセキュリティヘッダー
<IfModule mod_headers.c>
  Header always unset X-Frame-Options
  Header always set Content-Security-Policy "frame-ancestors 'self' *"
</IfModule>
